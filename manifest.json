{
  "manifest_version": 3,
  "name": "Kimi 模型用量统计",
  "version": "1.1.0",
  "author": "kimi-usage-stats contributors",
  "description": "统计 kimi code cli 每个模型的 token 消耗量与 tokens/s，支持峰谷计价，数据全部本地读取。",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content/content-script.js"],
      "css": ["content/inject.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel/panel.html", "panel/panel.css", "panel/panel.js", "lib/*", "icons/*"],
      "matches": ["http://127.0.0.1/*", "http://localhost/*"]
    }
  ]
}
